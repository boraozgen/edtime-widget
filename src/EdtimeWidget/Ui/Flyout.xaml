<Window x:Class="EdtimeWidget.Ui.Flyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="edtime" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Width="300"
        SizeToContent="Height" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="FlyoutButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlyoutButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlyoutButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SubFg}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
            CornerRadius="8" Padding="18,16,18,10">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,1,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StateText" FontSize="13" Foreground="{DynamicResource SubFg}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="TimerText" FontSize="40" FontWeight="SemiBold" Margin="0,4,0,0"
                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Fg}" />
            <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource SubFg}" TextWrapping="Wrap" />

            <StackPanel x:Name="Actions" Margin="0,16,0,0">
                <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" Click="PrimaryAction_Click" />
                <Button x:Name="SecondaryAction" Style="{StaticResource FlyoutButton}" Margin="0,8,0,0" Click="SecondaryAction_Click" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <Grid Margin="0,12,0,0">
                <TextBlock x:Name="UpdatedText" FontSize="11" Foreground="{DynamicResource SubFg}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Aktualisieren" Click="Refresh_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE774;" ToolTip="edtime im Browser öffnen" Click="OpenWeb_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Einstellungen" Click="Settings_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
