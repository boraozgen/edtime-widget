<Window x:Class="EdtimeWidget.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="edtime Widget – Einstellungen" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style x:Key="Input" TargetType="Control">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="edtime Mitarbeiter-Login" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Dieselben Zugangsdaten wie in der edtime App (Stempelmedien)." Foreground="{DynamicResource SubFg}"
                   TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Text="E-Mail / Benutzername" />
        <TextBox x:Name="UserBox" Style="{StaticResource Input}" />

        <TextBlock Text="Passwort / PIN" />
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource Input}" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Abfrage alle (Sek.)" />
                <TextBox x:Name="PollBox" Style="{StaticResource Input}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Abstand zum Tray (px)" />
                <TextBox x:Name="OffsetBox" Style="{StaticResource Input}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="AutostartBox" Content="Beim Windows-Start öffnen" Margin="0,0,0,8" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorFg}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="LogoutButton" Content="Abmelden" DockPanel.Dock="Left" Padding="12,5" Click="Logout_Click" />
            <Button Content="Abbrechen" DockPanel.Dock="Right" Padding="12,5" IsCancel="True" />
            <Button Content="Speichern" DockPanel.Dock="Right" Padding="16,5" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
        </DockPanel>
    </StackPanel>
</Window>
